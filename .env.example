# Copy to .env and adjust. All settings are optional.
# With Docker Compose, do not set SKYTRIPWIRE_HOST, SKYTRIPWIRE_PORT, SKYTRIPWIRE_DATA_DIR or
# SKYTRIPWIRE_FRONTEND_DIR here: the image sets them. Change the published port in compose.yaml.

# Native install only: address and port to listen on, database directory, built web UI.
# SKYTRIPWIRE_HOST=127.0.0.1
# SKYTRIPWIRE_PORT=8000
# SKYTRIPWIRE_DATA_DIR=data
# SKYTRIPWIRE_FRONTEND_DIR=../frontend/dist

# Extra host names the web UI may be opened with, besides 127.0.0.1 and localhost
# (comma-separated, without port). Protects against DNS rebinding and cross-site requests.
# Set your domain when using a reverse proxy, "*" turns the check off.
# SKYTRIPWIRE_ALLOWED_HOSTS=sky.example.org

# debug, info, warning or error
# SKYTRIPWIRE_LOG_LEVEL=info

# adsb.lol (default data source). Without a key the limit is 500 requests per day and IP.
# A free key raises it to 1,000 or 7,200; set the budget a bit below the real limit.
# SKYTRIPWIRE_ADSBLOL_API_KEY=
# SKYTRIPWIRE_ADSBLOL_DAILY_BUDGET=450

# Flightradar24 via the unofficial FlightRadarAPI library. Off by default.
# Personal and educational use only; commercial use requires contacting Flightradar24.
# SKYTRIPWIRE_FR24_ENABLED=false
# SKYTRIPWIRE_FR24_DAILY_BUDGET=1440

# Polling worker
# SKYTRIPWIRE_WORKER_ENABLED=true
# SKYTRIPWIRE_POLL_MIN_INTERVAL_SECONDS=60
# SKYTRIPWIRE_MAX_ALERTS_PER_FILTER_PER_CYCLE=10
